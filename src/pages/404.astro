---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在">
  <div class="wrap">
    <div class="spine">
      <section class="sec is-head">
        <div class="sec-h">
          <h1>404</h1>
        </div>
        <div class="sec-b">
          <p class="big">这个页面不存在。链接可能写错了，或者内容已经移走。</p>
          <p style="margin-top: 24px"><a class="btn" href="/">回到首页</a></p>
        </div>
      </section>
    </div>
  </div>
</Base>
