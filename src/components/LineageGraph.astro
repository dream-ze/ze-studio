---
// 首页的血缘图：站里的内容和它们之间的关联。
// 宽屏是四栏从左到右，窄屏是从上到下。两个版本用同一份数据。
import { COLUMNS, fit, getHomeGraph, layoutDesktop, layoutMobile } from '../lib/graph';

const { nodes, edges } = await getHomeGraph();
const d = layoutDesktop(nodes, edges);
const m = layoutMobile(nodes, edges);
const label =
  '站内内容的关系图。' +
  edges
    .map((e) => {
      const from = nodes.find((n) => n.key === e.from)?.title;
      const to = nodes.find((n) => n.key === e.to)?.title;
      return `${from} 通向 ${to}`;
    })
    .join('；');
const headerX = [50, 350, 650, 950];
---

<div class="graph">
  <svg class="g-desktop" viewBox={`0 0 ${d.width} ${d.height}`} role="group" aria-label={label}>
    <path
      class="g-sep"
      d={`M320 28V${d.height - 52}M620 28V${d.height - 52}M920 28V${d.height - 52}`}></path>
    {
      COLUMNS.map((c, i) => (
        <>
          <text class="g-col" x={headerX[i]} y="46">
            {c.name}
          </text>
          <text class="g-hint" x={headerX[i]} y="66">
            {c.hint}
          </text>
        </>
      ))
    }
    {d.wires.map((w) => <path class="g-wire" pathLength="1" d={w.d} />)}
    {d.wires.map((w) => <path class="g-head" d={w.head} />)}
    {
      d.boxes.map((b) => (
        <a href={b.node.href} class:list={['g-node', { 'is-hub': b.node.hub }]}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={b.node.hub ? 10 : 8} />
          {b.node.hub ? (
            <>
              <text class="g-hub-title" x={b.x + 20} y={b.cy - 3}>
                {fit(b.node.title, 12.5)}
              </text>
              <text class="g-hub-sub" x={b.x + 20} y={b.cy + 16}>
                {fit(b.node.sub ?? '', 16)}
              </text>
            </>
          ) : b.node.col === 3 ? (
            <text x={b.x + 18} y={b.cy + 5}>
              {fit(b.node.title, 11.5)}
            </text>
          ) : (
            <>
              <circle class={`g-dot g-${b.node.state}`} cx={b.x + 20} cy={b.cy} r="4" />
              <text x={b.x + 34} y={b.cy + 5}>
                {fit(b.node.title, 14.2)}
              </text>
            </>
          )}
        </a>
      ))
    }
    <g class="g-legend" transform={`translate(0 ${d.height - 26})`}>
      <circle class="g-dot g-done" cx="54" cy="0" r="4"></circle>
      <text x="66" y="4">已发布或已完成</text>
      <circle class="g-dot g-idea" cx="184" cy="0" r="4"></circle>
      <text x="196" y="4">构想</text>
      <path class="g-wire" d="M244 0H272"></path>
      <path class="g-head" d="M281 0l-9-4.5v9z"></path>
      <text x="290" y="4">有依据的关联</text>
      <text x="1150" y="4" text-anchor="end">每个方块是站里的一条内容，每条线是一处真实的关联</text>
    </g>
  </svg>

  <svg class="g-mobile" viewBox={`0 0 ${m.width} ${m.height}`} role="group" aria-label={label}>
    {
      m.headers.map((h) => (
        <text x="52" y={h.y}>
          <tspan class="g-col">{COLUMNS[h.col].name}</tspan>
          <tspan class="g-hint" dx="10">
            {COLUMNS[h.col].hint}
          </tspan>
        </text>
      ))
    }
    {m.wires.map((w) => <path class="g-wire" pathLength="1" d={w.d} />)}
    {m.wires.map((w) => <path class="g-head" d={w.head} />)}
    {
      m.boxes.map((b) => (
        <a href={b.node.href} class:list={['g-node', { 'is-hub': b.node.hub }]}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx={b.node.hub ? 10 : 8} />
          {b.node.hub ? (
            <>
              <text class="g-hub-title" x={b.x + 16} y={b.cy - 3}>
                {fit(b.node.title, 15)}
              </text>
              <text class="g-hub-sub" x={b.x + 16} y={b.cy + 15}>
                {fit(b.node.sub ?? '', 19)}
              </text>
            </>
          ) : b.node.col === 3 ? (
            <text x={b.x + 16} y={b.cy + 5}>
              {fit(b.node.title, 18)}
            </text>
          ) : (
            <>
              <circle class={`g-dot g-${b.node.state}`} cx={b.x + 16} cy={b.cy} r="4" />
              <text x={b.x + 28} y={b.cy + 5}>
                {fit(b.node.title, 17.5)}
              </text>
            </>
          )}
        </a>
      ))
    }
    <g class="g-legend" transform={`translate(0 ${m.legendY})`}>
      <circle class="g-dot g-done" cx="56" cy="0" r="4"></circle>
      <text x="66" y="4">已发布或完成</text>
      <circle class="g-dot g-idea" cx="160" cy="0" r="4"></circle>
      <text x="170" y="4">构想</text>
      <path class="g-wire" d="M212 0H234"></path>
      <path class="g-head" d="M243 0l-9-4.5v9z"></path>
      <text x="250" y="4">有依据的关联</text>
    </g>
  </svg>
</div>

<style>
  .graph {
    width: calc(100% - 80px);
    max-width: 1200px;
    margin-inline: auto;
    border-radius: 16px;
    background: var(--panel);
    overflow: hidden;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    font-size: 13.5px;
    fill: var(--panel-text);
  }

  .g-mobile {
    display: none;
    max-width: 430px;
    margin-inline: auto;
    font-size: 13px;
  }

  .g-sep {
    fill: none;
    stroke: var(--panel-line);
    stroke-dasharray: 2 6;
  }

  .g-col {
    font-size: 15px;
    font-weight: 600;
  }

  .g-hint {
    font-size: 12.5px;
    fill: var(--panel-muted);
  }

  .g-wire {
    fill: none;
    stroke: var(--edge);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 1.1s ease-out both;
  }

  .g-legend .g-wire {
    stroke-dasharray: none;
    animation: none;
  }

  .g-head {
    fill: var(--edge);
  }

  .g-node rect {
    fill: var(--panel-node);
    stroke: var(--panel-line);
    transition: stroke 0.15s ease;
  }

  .g-node:hover rect,
  .g-node:focus-visible rect {
    stroke: var(--edge);
  }

  .g-node:focus-visible {
    outline: none;
  }

  .g-node:focus-visible rect {
    stroke-width: 2;
  }

  .g-node.is-hub rect {
    fill: var(--lime);
    stroke: none;
  }

  .g-node.is-hub:hover rect,
  .g-node.is-hub:focus-visible rect {
    stroke: #fff;
    stroke-width: 2;
  }

  .g-hub-title {
    font-size: 15.5px;
    font-weight: 600;
    fill: var(--ink);
  }

  .g-hub-sub {
    font-size: 12px;
    fill: #2f3d12;
  }

  .g-dot {
    fill: var(--panel-text);
  }

  .g-idea,
  .g-archived,
  .g-none {
    fill: none;
    stroke: var(--panel-text);
    stroke-width: 1.5;
  }

  .g-active {
    fill: var(--edge);
  }

  .g-archived {
    stroke-dasharray: 2 2;
  }

  .g-legend {
    font-size: 12.5px;
    fill: var(--panel-muted);
  }

  .g-legend .g-dot {
    fill: var(--panel-muted);
    stroke: none;
  }

  .g-legend .g-idea {
    fill: none;
    stroke: var(--panel-muted);
    stroke-width: 1.5;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 1040px) {
    .graph {
      width: calc(100% - 2 * clamp(16px, 4vw, 40px));
      border-radius: 14px;
    }

    .g-desktop {
      display: none;
    }

    .g-mobile {
      display: block;
    }
  }
</style>
