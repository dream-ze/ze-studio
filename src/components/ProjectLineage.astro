---
// 项目页上的小血缘图：这个项目从哪里来，支撑什么。
// 宽屏画成图，窄屏排成两组链接。没有任何关联时什么都不显示。
import { fit, getNeighbors } from '../lib/graph';

interface Props {
  id: string;
}

const { self, upstream, downstream } = await getNeighbors(`projects/${Astro.props.id}`);
const show = self && upstream.length + downstream.length > 0;

const ROW = 40;
const GAP = 12;
const TOP = 52;
const rows = Math.max(upstream.length, downstream.length, 1);
const span = (n: number) => n * ROW + (n - 1) * GAP;
const mid = TOP + Math.max(span(rows), 56) / 2;
const height = TOP + Math.max(span(rows), 56) + 32;
const startY = (n: number) => mid - span(n) / 2;

const UP = { x: 40, w: 320 };
const HUB = { x: 450, w: 230, h: 56 };
const DOWN = { x: 790, w: 240 };

const up = upstream.map((node, i) => ({ node, y: startY(upstream.length) + i * (ROW + GAP) }));
const down = downstream.map((node, i) => ({ node, y: startY(downstream.length) + i * (ROW + GAP) }));
const spread = (i: number, n: number) => (i - (n - 1) / 2) * Math.min(10, 36 / Math.max(1, n - 1));
const curve = (sx: number, sy: number, ex: number, ey: number) =>
  Math.abs(sy - ey) < 0.5
    ? `M${sx} ${sy}H${ex}`
    : `M${sx} ${sy}C${sx + (ex - sx) * 0.55} ${sy} ${ex - (ex - sx) * 0.55} ${ey} ${ex} ${ey}`;
---

{
  show && (
    <div class="lineage">
      <svg viewBox={`0 0 1088 ${height}`} role="group" aria-label={`${self.title} 的上游和下游`}>
        {up.length > 0 && (
          <text class="cap" x={UP.x} y="30">
            它从哪里来
          </text>
        )}
        <text class="cap" x={HUB.x} y="30">
          本项目
        </text>
        {down.length > 0 && (
          <text class="cap" x={DOWN.x} y="30">
            它支撑什么
          </text>
        )}

        {up.map((u, i) => {
          const ey = mid + spread(i, up.length);
          return (
            <>
              <path class="wire" d={curve(UP.x + UP.w, u.y + ROW / 2, HUB.x - 10, ey)} />
              <path class="head" d={`M${HUB.x - 1} ${ey}l-9-4.5v9z`} />
            </>
          );
        })}
        {down.map((v, i) => {
          const sy = mid + spread(i, down.length);
          return (
            <>
              <path class="wire" d={curve(HUB.x + HUB.w, sy, DOWN.x - 10, v.y + ROW / 2)} />
              <path class="head" d={`M${DOWN.x - 1} ${v.y + ROW / 2}l-9-4.5v9z`} />
            </>
          );
        })}

        {up.map((u) => (
          <a href={u.node.href} class="node">
            <rect x={UP.x} y={u.y} width={UP.w} height={ROW} rx="8" />
            <text x={UP.x + 16} y={u.y + 25}>
              {fit(u.node.title, 18)}
            </text>
            <text class="kind" x={UP.x + UP.w - 14} y={u.y + 25} text-anchor="end">
              {u.node.kind}
            </text>
          </a>
        ))}

        <rect class="hub" x={HUB.x} y={mid - HUB.h / 2} width={HUB.w} height={HUB.h} rx="10" />
        <text class="hub-title" x={HUB.x + 18} y={mid - 3}>
          {fit(self.title, 12.5)}
        </text>
        <text class="hub-sub" x={HUB.x + 18} y={mid + 16}>
          {fit(self.sub ?? '', 16)}
        </text>

        {down.map((v) => (
          <a href={v.node.href} class="node">
            <rect x={DOWN.x} y={v.y} width={DOWN.w} height={ROW} rx="8" />
            <text x={DOWN.x + 16} y={v.y + 25}>
              {fit(v.node.title, 12)}
            </text>
            <text class="kind" x={DOWN.x + DOWN.w - 14} y={v.y + 25} text-anchor="end">
              {v.node.kind}
            </text>
          </a>
        ))}
      </svg>

      <div class="plain">
        {upstream.length > 0 && (
          <div>
            <p class="plain-cap">它从哪里来</p>
            <ul>
              {upstream.map((n) => (
                <li>
                  <a href={n.href}>{n.title}</a>
                  <span>{n.kind}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {downstream.length > 0 && (
          <div>
            <p class="plain-cap">它支撑什么</p>
            <ul>
              {downstream.map((n) => (
                <li>
                  <a href={n.href}>{n.title}</a>
                  <span>{n.kind}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  )
}

<style>
  .lineage {
    border-radius: 14px;
    background: var(--panel);
    color: var(--panel-text);
    overflow: hidden;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--panel-text);
  }

  .cap,
  .kind {
    fill: var(--panel-muted);
  }

  .kind {
    font-size: 11.5px;
  }

  .wire {
    fill: none;
    stroke: var(--edge);
    stroke-width: 1.6;
  }

  .head {
    fill: var(--edge);
  }

  .node rect {
    fill: var(--panel-node);
    stroke: var(--panel-line);
  }

  .node:hover rect,
  .node:focus-visible rect {
    stroke: var(--edge);
  }

  .node:focus-visible {
    outline: none;
  }

  .hub {
    fill: var(--lime);
  }

  .hub-title {
    font-size: 15px;
    font-weight: 600;
    fill: var(--ink);
  }

  .hub-sub {
    font-size: 12px;
    fill: #2f3d12;
  }

  .plain {
    display: none;
    padding: 20px 18px 8px;
  }

  .plain-cap {
    font-size: 12.5px;
    color: var(--panel-muted);
  }

  .plain ul {
    list-style: none;
    margin: 4px 0 14px;
    padding: 0;
  }

  .plain li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    border-top: 1px solid var(--panel-line);
    font-size: 15px;
  }

  .plain li:first-child {
    border-top: 0;
  }

  .plain a {
    color: var(--panel-text);
    text-decoration: underline;
    text-decoration-color: var(--edge);
    text-underline-offset: 5px;
  }

  .plain span {
    flex: none;
    font-size: 12.5px;
    color: var(--panel-muted);
  }

  @media (max-width: 1040px) {
    svg {
      display: none;
    }

    .plain {
      display: block;
    }
  }
</style>
