---
// 深色页脚，同时是全站的“联系我”。每个页面底部都有，导航里的“联系我”跳到这里。
import { CONTACT, SITE } from '../consts';

const year = new Date().getFullYear();
const { email, github } = CONTACT;
---

<footer id="contact">
  <div class="wrap inner">
    <h2 class="serif">想法有共鸣，<br />或者有事想一起做？</h2>
    <dl>
      <div>
        <dt>邮箱</dt>
        <dd>{email ? <a href={`mailto:${email}`}>{email}</a> : <span class="todo">待补充</span>}</dd>
      </div>
      <div>
        <dt>GitHub</dt>
        <dd>
          {
            github ? (
              <a href={`https://github.com/${github}`} rel="me noopener">
                @{github}
              </a>
            ) : (
              <span class="todo">待补充</span>
            )
          }
        </dd>
      </div>
      <div>
        <dt>RSS</dt>
        <dd><a href="/rss.xml">订阅 Research 的更新</a></dd>
      </div>
    </dl>
    <p class="copy mono">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  footer {
    background: var(--panel);
    color: var(--panel-text);
  }

  .inner {
    padding-top: 84px;
    padding-bottom: max(40px, env(safe-area-inset-bottom, 0px));
    /* 和正文对齐：正文在蓝线右侧 32px */
    padding-left: calc(max(var(--gutter), env(safe-area-inset-left, 0px)) + 32px);
  }

  h2 {
    font-size: 44px;
    font-weight: 900;
    line-height: 1.3;
    color: #fff;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 32px;
    margin: 44px 0 0;
    padding-top: 26px;
    border-top: 1px solid var(--panel-line);
  }

  dt {
    font-size: 13px;
    color: var(--panel-muted);
  }

  dd {
    margin: 4px 0 0;
    font-size: 19px;
    overflow-wrap: anywhere;
  }

  dd a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--lime);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  dd a:hover {
    color: #fff;
  }

  .todo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--panel-muted);
  }

  .copy {
    margin-top: 56px;
    font-size: 12.5px;
    color: var(--panel-muted);
  }

  @media (max-width: 860px) {
    .inner {
      padding-top: 52px;
      padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    }

    h2 {
      font-size: 30px;
      line-height: 1.35;
    }

    dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      margin-top: 28px;
      padding-top: 22px;
    }

    dd {
      font-size: 17px;
    }

    .copy {
      margin-top: 36px;
    }
  }
</style>
