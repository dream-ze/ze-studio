---
// 状态：一个小圆点加文字。形状区分状态，不靠颜色。
interface Props {
  status: string;
}

const { status } = Astro.props;

const kind: Record<string, string> = {
  构想: 'idea',
  进行中: 'active',
  开发中: 'active',
  完成: 'done',
  自用中: 'done',
  已归档: 'archived',
  放弃: 'archived',
};
---

<span class={`st st-${kind[status] ?? 'done'}`}><i aria-hidden="true"></i>{status}</span>
